# Server
PORT=4000
NODE_ENV=development

# MSSQL connection (tedious driver via `mssql` — needs a TCP-reachable server;
# LocalDB's named-pipe-only instances will NOT work here, see README)
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=TmoGradingQueue
DB_USER=sa
DB_PASSWORD=changeme
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
# Small, mostly-idle workload (SPEC §6: "ผู้ใช้พร้อมกันน้อย") — a big pool
# buys nothing here, so kept small deliberately.
DB_POOL_MIN=2
DB_POOL_MAX=10

# Auth (SPEC §2.2)
# TTL sized to "ความยาวงานแข่งขัน 1 วัน" — long enough to cover one competition
# day (rotation starts 13:30, SPEC §2.4) without re-login, short enough that a
# leaked token is not a standing risk after the event ends.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h

# bcrypt cost factor — standard default, no reason to deviate for this scale.
BCRYPT_SALT_ROUNDS=10
